-- table activity_events
CREATE TABLE activity_events (
  id integer primary key autoincrement,
  type text not null,
  actor_user_id integer not null references users (id) on delete restrict,
  booking_id integer references bookings (id) on delete restrict,
  resource_id integer references resources (id) on delete restrict,
  subject_user_id integer references users (id) on delete restrict,
  payload text not null,
  at integer not null,
  check (type in ('booking.created', 'booking.approved', 'booking.rejected', 'booking.cancelled', 'resource.created', 'resource.updated', 'resource.archived')),
  check ((substr(type, 1, 8) = 'booking.') = (booking_id is not null)),
  check ((substr(type, 1, 9) = 'resource.') = (subject_user_id is null)),
  check ((substr(type, 1, 9) = 'resource.') <= (resource_id is not null)),
  check (json_valid(payload) and json_type(payload) = 'object'),
  -- Payloads never contain the purpose of a booking (AD-17).
  check (json_type(payload, '$.purpose') is null)
) strict;

-- table app_meta
CREATE TABLE app_meta (
  key text primary key,
  value text not null,
  check (length(key) > 0)
) strict, without rowid;

-- table bookings
CREATE TABLE bookings (
  id integer primary key autoincrement,
  resource_id integer not null references resources (id) on delete restrict,
  user_id integer not null references users (id) on delete restrict,
  start_at integer not null,
  end_at integer not null,
  purpose text not null,
  status text not null,
  created_at integer not null,
  decided_by_user_id integer references users (id) on delete restrict,
  decided_at integer,
  decision_reason text,
  cancelled_by_user_id integer references users (id) on delete restrict,
  cancelled_at integer,
  cancel_reason text,

  check (status in ('pending', 'confirmed', 'rejected', 'cancelled')),
  check (length(trim(purpose)) > 0),

  -- The grid and the duration have a free database backstop (Oslo offsets are whole hours). The 08:00-22:00
  -- window and "not in the past" are application-only.
  check (end_at > start_at),
  check (start_at % 1800000 = 0 and end_at % 1800000 = 0),
  check (end_at - start_at between 1800000 and 14400000),

  -- Decision: who and when travel together; nobody decides their own booking; a pending booking has no decision.
  check ((decided_by_user_id is null) = (decided_at is null)),
  check (decided_by_user_id is null or decided_by_user_id <> user_id),
  check (status <> 'pending' or decided_by_user_id is null),
  check (decision_reason is null or decided_by_user_id is not null),
  check (status <> 'rejected' or (decided_by_user_id is not null and decision_reason is not null and length(trim(decision_reason)) > 0)),

  -- Cancellation: exactly the cancelled rows have a canceller; someone else's booking needs a reason.
  check ((status = 'cancelled') = (cancelled_by_user_id is not null)),
  check ((cancelled_by_user_id is null) = (cancelled_at is null)),
  check (cancelled_by_user_id is null or cancelled_by_user_id = user_id or (cancel_reason is not null and length(trim(cancel_reason)) > 0)),
  check (cancelled_by_user_id is not null or cancel_reason is null)
) strict;

-- table resources
CREATE TABLE resources (
  id integer primary key autoincrement,
  name text not null,
  kind text not null,
  description text,
  location text not null,
  seats integer,
  symbol text not null,
  colour text not null,
  approval_required integer not null,
  status text not null default 'active',
  created_at integer not null,
  check (length(trim(name)) > 0),
  check (kind in ('room', 'equipment')),
  check (description is null or length(trim(description)) > 0),
  check (length(trim(location)) > 0),
  check (seats is null or seats between 1 and 1000),
  check (symbol in ('users', 'monitor', 'door-closed', 'presentation', 'projector', 'camera', 'mic', 'pen-line', 'laptop', 'headphones')),
  check (colour in ('bla', 'gronn', 'lilla', 'oransje', 'rosa', 'teal', 'gul', 'gra')),
  check (approval_required in (0, 1)),
  check (status in ('active', 'archived'))
) strict;

-- table schema_migrations
CREATE TABLE schema_migrations (version integer primary key, name text not null, checksum text not null, applied_at integer not null) strict;

-- table sessions
CREATE TABLE sessions (
  id integer primary key autoincrement,
  token_hash text not null unique,
  user_id integer not null references users (id) on delete restrict,
  created_at integer not null,
  expires_at integer not null,
  check (length(token_hash) = 64),
  check (expires_at > created_at)
) strict;

-- table users
CREATE TABLE users (
  id integer primary key autoincrement,
  email text not null unique,
  name text not null,
  role text not null,
  password_hash text not null,
  created_at integer not null,
  check (email = lower(email) and length(trim(email)) > 0),
  check (length(trim(name)) > 0),
  check (role in ('member', 'admin')),
  check (password_hash like 'scrypt$%')
) strict;

-- index activity_events_by_booking on activity_events
CREATE INDEX activity_events_by_booking on activity_events (booking_id, id);

-- index activity_events_by_subject on activity_events
CREATE INDEX activity_events_by_subject on activity_events (subject_user_id, id);

-- index bookings_blocking on bookings
CREATE INDEX bookings_blocking on bookings (resource_id, status, start_at);

-- index bookings_by_status on bookings
CREATE INDEX bookings_by_status on bookings (status, start_at);

-- index bookings_by_user on bookings
CREATE INDEX bookings_by_user on bookings (user_id, start_at);

-- index resources_by_status on resources
CREATE INDEX resources_by_status on resources (status, kind);

-- index sessions_by_expiry on sessions
CREATE INDEX sessions_by_expiry on sessions (expires_at);

-- index sessions_by_user on sessions
CREATE INDEX sessions_by_user on sessions (user_id);

-- trigger bookings_approve_needs_approver on bookings
CREATE TRIGGER bookings_approve_needs_approver before update of status on bookings
when old.status = 'pending' and new.status = 'confirmed' and new.decided_by_user_id is null
begin
  select raise(abort, 'BOOKING_APPROVER_REQUIRED');
end;

-- trigger bookings_decision_write_once on bookings
CREATE TRIGGER bookings_decision_write_once before update of decided_by_user_id, decided_at, decision_reason, cancelled_by_user_id, cancelled_at, cancel_reason on bookings
when (old.decided_by_user_id is not null and (new.decided_by_user_id is not old.decided_by_user_id or new.decided_at is not old.decided_at))
  or (old.decision_reason is not null and new.decision_reason is not old.decision_reason)
  or (old.cancelled_by_user_id is not null)
begin
  select raise(abort, 'BOOKING_DECISION_WRITE_ONCE');
end;

-- trigger bookings_illegal_transition on bookings
CREATE TRIGGER bookings_illegal_transition before update of status on bookings
when not (
  old.status = new.status
  or (old.status = 'pending' and new.status in ('confirmed', 'rejected', 'cancelled'))
  or (old.status = 'confirmed' and new.status = 'cancelled')
)
begin
  select raise(abort, 'BOOKING_ILLEGAL_TRANSITION');
end;

-- trigger bookings_immutable on bookings
CREATE TRIGGER bookings_immutable before update of resource_id, user_id, start_at, end_at, purpose on bookings
begin
  select raise(abort, 'BOOKING_IMMUTABLE');
end;

-- trigger bookings_no_delete on bookings
CREATE TRIGGER bookings_no_delete before delete on bookings
begin
  select raise(abort, 'BOOKING_NO_DELETE');
end;

-- trigger bookings_no_overlap on bookings
CREATE TRIGGER bookings_no_overlap before insert on bookings
when new.status in ('pending', 'confirmed')
  and exists (
    select 1 from bookings b
    where b.resource_id = new.resource_id
      and b.status in ('pending', 'confirmed')
      and b.start_at < new.end_at
      and new.start_at < b.end_at
  )
begin
  select raise(abort, 'BOOKING_OVERLAP');
end;

-- trigger bookings_no_replace on bookings
CREATE TRIGGER bookings_no_replace before insert on bookings
when new.id is not null and exists (select 1 from bookings where id = new.id)
begin
  select raise(abort, 'BOOKING_NO_DELETE');
end;

-- trigger bookings_terminal_frozen on bookings
CREATE TRIGGER bookings_terminal_frozen before update on bookings
when old.status in ('rejected', 'cancelled')
begin
  select raise(abort, 'BOOKING_TERMINAL');
end;

-- trigger events_immutable on activity_events
CREATE TRIGGER events_immutable before update on activity_events
begin
  select raise(abort, 'EVENT_IMMUTABLE');
end;

-- trigger events_no_delete on activity_events
CREATE TRIGGER events_no_delete before delete on activity_events
begin
  select raise(abort, 'EVENT_NO_DELETE');
end;

-- trigger events_no_replace on activity_events
CREATE TRIGGER events_no_replace before insert on activity_events
when new.id is not null and exists (select 1 from activity_events where id = new.id)
begin
  select raise(abort, 'EVENT_NO_DELETE');
end;

-- trigger events_subject_matches on activity_events
CREATE TRIGGER events_subject_matches before insert on activity_events
when new.subject_user_id is not (select user_id from bookings where id = new.booking_id)
begin
  select raise(abort, 'EVENT_SUBJECT_MISMATCH');
end;

-- trigger resources_archive_final on resources
CREATE TRIGGER resources_archive_final before update on resources
when old.status = 'archived' and new.status <> 'archived'
begin
  select raise(abort, 'RESOURCE_ARCHIVE_FINAL');
end;

-- trigger resources_no_delete on resources
CREATE TRIGGER resources_no_delete before delete on resources
begin
  select raise(abort, 'RESOURCE_NO_DELETE');
end;
