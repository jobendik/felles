# Copy to .env if you need to change a value. No secret exists in FELLES; every variable has a default.
FELLES_PORT=3000
FELLES_HOST=127.0.0.1
FELLES_DB_PATH=data/felles.db
# FELLES_NOW=2026-10-19T07:00:00Z   # test and demo only; refused when NODE_ENV=production
# FELLES_ALLOWED_ORIGINS=
# FELLES_ALLOWED_HOSTS=
FELLES_COOKIE_SECURE=auto
# FELLES_SCRYPT_N=65536
FELLES_LOG_LEVEL=info
FELLES_VITE_PORT=5173
# FELLES_ALLOW_REMOTE_DEMO=1
# NODE_ENV=development
